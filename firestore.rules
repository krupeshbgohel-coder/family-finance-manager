rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Deny all client access by default.
    // Before enabling family sync, implement a reviewed membership model:
    // families/{familyId}/members/{uid} with an active membership field.
    // Then scope all reads/writes to authenticated users with active membership.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

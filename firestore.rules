rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function familyPath(familyId) { return /databases/$(database)/documents/families/$(familyId); }
    function activeMember(familyId) {
      return signedIn() && exists(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)).data.status == 'ACTIVE';
    }
    function admin(familyId) {
      return activeMember(familyId)
        && get(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)).data.role == 'ADMIN';
    }

    match /families/{familyId} {
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow read: if activeMember(familyId) || (signedIn() && resource.data.createdBy == request.auth.uid);
      allow update, delete: if admin(familyId);

      match /members/{uid} {
        allow read: if activeMember(familyId) && (request.auth.uid == uid || admin(familyId));
        allow create: if signedIn() && request.auth.uid == uid && request.resource.data.uid == request.auth.uid
          && ((get(familyPath(familyId)).data.createdBy == request.auth.uid && request.resource.data.role == 'ADMIN' && request.resource.data.status == 'ACTIVE')
            || (request.auth.token.email != null
              && exists(/databases/$(database)/documents/families/$(familyId)/invitations/$(request.auth.token.email.lower()))
              && get(/databases/$(database)/documents/families/$(familyId)/invitations/$(request.auth.token.email.lower())).data.status == 'PENDING'
              && get(/databases/$(database)/documents/families/$(familyId)/invitations/$(request.auth.token.email.lower())).data.role == request.resource.data.role
              && request.resource.data.status == 'ACTIVE'));
        allow update: if admin(familyId) && request.resource.data.uid == uid;
        allow delete: if admin(familyId) && uid != request.auth.uid;
      }
      match /invitations/{email} {
        allow read, create, delete: if admin(familyId);
        allow update: if admin(familyId) || (signedIn() && request.auth.token.email != null
          && request.auth.token.email.lower() == email && resource.data.status == 'PENDING'
          && request.resource.data.status == 'ACCEPTED' && request.resource.data.acceptedBy == request.auth.uid);
      }
      match /{collection}/{docId} {
        allow read: if activeMember(familyId);
        allow create, update, delete: if collection != 'members' && collection != 'invitations'
          && activeMember(familyId)
          && get(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)).data.role in ['ADMIN', 'MANAGER', 'MEMBER'];
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
